name: Deploy Static Site to Public Link

on:
  push:
    branches: ["main"] # Triggers when code pushes to main

# Sets permissions of the GITHUB_TOKEN to allow deployment to GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Allow only one concurrent deployment
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Pages
        uses: actions/configure-pages@v4

      # REPLACE THIS: Build your site here if needed (npm run build, etc.)
      # Ensure your built files are in a specific folder (e.g., './dist' or './public')

      - name: Upload Website Files
        uses: actions/upload-pages-artifact@v3
        with:
          path: './public' # Point to the folder containing your index.html file

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

